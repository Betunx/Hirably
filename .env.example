# ─────────────────────────────────────────────────────────────────────────────
# Hirably — environment variables (Careers feature)
# Copy this file to `.env` and fill in real values for local testing with
# `vercel dev`. NEVER commit `.env` (it is gitignored). In Vercel, set these in
# Project → Settings → Environment Variables instead.
# ─────────────────────────────────────────────────────────────────────────────

# ── Upstash Redis (vacancies store) ──────────────────────────────────────────
# Created via Vercel → Storage → Marketplace → Upstash Redis (or upstash.com).
# The Vercel integration injects KV_REST_API_* automatically in deploys; for
# local `vercel dev` paste them here. UPSTASH_REDIS_REST_* also work (the API
# reads either name).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Vercel Blob (CV uploads) ─────────────────────────────────────────────────
# Created via Vercel → Storage → Blob. Auto-injected in deploys; paste here for
# local `vercel dev`.
BLOB_READ_WRITE_TOKEN=

# ── Applications email (postulaciones a talent@) ─────────────────────────────
# NOT an env var. Applications are sent via Formspree (same provider as the
# contact forms). The careers form endpoint lives in
# src/environments/environment(.prod).ts → `careersFormspreeEndpoint`. Create a
# Formspree form delivering to talent@hirablystaffing.com and paste its endpoint
# there.

# ── Admin key (vacancy create/edit/delete) ──────────────────────────────────
# Shared secret required by POST/PATCH/DELETE on /api/vacancies. Pick a long
# random string. IMPORTANT in Vercel: set this ONLY on the Preview/preproduction
# environment, NOT on Production, so production rejects all writes server-side.
ADMIN_TOKEN=
